{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "test": "vitest run",
    "reset-breakglass": "node --env-file-if-exists=../.env src/cli/reset-breakglass.js",
    "docs:lint": "redocly lint",
    "docs:build": "node scripts/build-docs.mjs",
    "build": "npm run docs:build",
    "test:db": "TEST_DB=sqlite,postgres,mariadb vitest run test/db-engines.test.js",
    "test:postgres": "TEST_ENGINE=postgres vitest run",
    "test:mariadb": "TEST_ENGINE=mariadb vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@aws-sdk/client-bedrock": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@google/genai": "^2.30.0",
    "@node-saml/node-saml": "^5.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "node-pty": "^1.1.0",
    "openai": "^7.34.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "simple-git": "^4.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}

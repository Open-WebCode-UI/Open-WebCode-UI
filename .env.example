# Public URL of the app (used for SAML ACS/metadata URLs, WebAuthn, and cookie flags). Use https:// in production.
BASE_URL=https://code.example.com
PORT=3000
# Where the SQLite DB, project workspaces, and checkpoints live.
DATA_DIR=./data
# Key material for encrypting stored secrets (API keys, TOTP secrets, SP private key). If unset a key file is generated in DATA_DIR.
ENCRYPTION_KEY=
# Break-glass admin created on first start. If unset a random password is printed once to the console.
BREAKGLASS_PASSWORD=
# Set to the number of reverse proxies in front of the app so client IPs are correct.
TRUST_PROXY=1
NODE_ENV=production
# Local development over http only:
# ALLOW_INSECURE_DEV=1

# --- HTTPS ---
# Local development over https: set BASE_URL=https://localhost:3000 and the server serves HTTPS itself using an auto-generated
# self-signed certificate (stored in DATA_DIR/tls, valid for localhost, 127.0.0.1 and ::1). No ALLOW_INSECURE_DEV needed.
# With the Vite dev server also set API_URL=https://localhost:3000 for the UI process.
# Use your own certificate (any host name) with PEM file paths:
# TLS_CERT=/etc/ssl/certs/app.pem
# TLS_KEY=/etc/ssl/private/app.key
# Behind a TLS-terminating reverse proxy set TRUST_PROXY and leave TLS_* unset (the server then speaks plain HTTP to the proxy).
# If none of the above is set, the server starts on plain HTTP and an administrator chooses between a self-signed certificate and
# no HTTPS under Admin > HTTPS (takes effect after a restart).
